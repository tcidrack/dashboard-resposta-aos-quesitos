# Credenciais públicas (anon) do Supabase — mesmo projeto do Robô Parecer.
# Copie este arquivo para .env e preencha os valores.
#
# O painel lê a VIEW vw_respostas_quesitos, não a tabela: a anon não tem
# policy de SELECT em respostas_quesitos, justamente para os campos do
# beneficiário (idade e data de adesão) ficarem fora do alcance da chave
# pública, que vai no bundle do navegador.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
